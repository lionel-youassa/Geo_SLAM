<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.geo_slam.ui.splash.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_statusFragment"
            app:destination="@id/statusFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/statusFragment"
        android:name="com.example.geo_slam.ui.status.StatusFragment"
        android:label="Statut système"
        tools:layout="@layout/fragment_status">
        <action
            android:id="@+id/action_statusFragment_to_calibrationSheet"
            app:destination="@id/calibrationSheet"/>
        <action
            android:id="@+id/action_statusFragment_to_mapFragment"
            app:destination="@id/mapFragment"/>
    </fragment>

    <!-- Placeholder — sera remplacé par la bottom sheet de calibration -->
    <fragment
        android:id="@+id/calibrationSheet"
        android:name="com.example.geo_slam.ui.calibration.CalibrationFragment"
        android:label="Calibration"/>

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.example.geo_slam.ui.map.MapFragment"
        android:label="Map"
        tools:layout="@layout/fragment_map" />

</navigation>