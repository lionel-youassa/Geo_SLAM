<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6">

    <!-- Header Gradient (Inspiré de l'image) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_section"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/bg_header_rounded_bottom"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/icon_map"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_white_rounded"
            android:padding="10dp"
            android:src="@drawable/ic_map"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="#673AB7" />

        <TextView
            android:id="@+id/chip_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_status"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="● En cours"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            app:layout_constraintTop_toTopOf="@id/icon_map"
            app:layout_constraintBottom_toBottomOf="@id/icon_map"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/title_loc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Localisation"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/icon_map"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Localisation en temps réel"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/title_loc"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Sélecteur de mode -->
    <androidx.cardview.widget.CardView
        android:id="@+id/mode_selector_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="-30dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/header_section">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODE DE LOCALISATION"
                android:textColor="#757575"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFootSlam"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="FootSLAM"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    app:cornerRadius="20dp"
                    android:textColor="#26A69A"
                    app:strokeColor="#26A69A"
                    app:backgroundTint="#E0F2F1"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFusion"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:text="Fusion"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    app:cornerRadius="20dp"
                    android:textColor="#26A69A"
                    app:strokeColor="#26A69A"
                    app:backgroundTint="#E0F2F1"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVSlam"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="vSLAM"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    app:cornerRadius="20dp"
                    android:textColor="#26A69A"
                    app:strokeColor="#26A69A"
                    app:backgroundTint="#E0F2F1"/>

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Map View -->
    <com.example.geo_slam.ui.map.MapCanvasView
        android:id="@+id/mapCanvasView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_map_frame"
        app:layout_constraintTop_toBottomOf="@id/mode_selector_card"
        app:layout_constraintBottom_toTopOf="@id/legend_card" />

    <!-- Légende -->
    <androidx.cardview.widget.CardView
        android:id="@+id/legend_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toTopOf="@id/actions_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LÉGENDE"
                android:textColor="#757575"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View android:layout_width="15dp" android:layout_height="3dp" android:background="#673AB7"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" FootSLAM" android:textSize="12sp" android:layout_marginEnd="16dp"/>

                <View android:layout_width="15dp" android:layout_height="3dp" android:background="#26A69A"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" vSLAM" android:textSize="12sp" android:layout_marginEnd="16dp"/>

                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/dot_red"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Position" android:textSize="12sp"/>

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Actions -->
    <LinearLayout
        android:id="@+id/actions_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Arrêter"
            android:textColor="#FF5252"
            app:icon="@drawable/ic_stop"
            app:iconTint="#FF5252"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_save"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            android:backgroundTint="#B2EBF2"
            app:iconTint="#26A69A"
            app:cornerRadius="12dp"/>

    </LinearLayout>

    <!-- Calibration Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/calibrationOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:elevation="20dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/txtCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3"
            android:textColor="#FFFFFF"
            android:textSize="100sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
