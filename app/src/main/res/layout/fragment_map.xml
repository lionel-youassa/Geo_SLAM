<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6">

    <!-- Header Gradient -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_section"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_header_rounded_bottom"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/icon_map"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_white_rounded"
            android:padding="8dp"
            android:src="@drawable/ic_map"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="#673AB7" />

        <TextView
            android:id="@+id/chip_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_status"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="● En cours"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            app:layout_constraintTop_toTopOf="@id/icon_map"
            app:layout_constraintBottom_toBottomOf="@id/icon_map"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/title_loc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Localisation"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/icon_map"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suivi en temps réel"
            android:textColor="#E0E0E0"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/title_loc"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Sélecteur de mode (Dropdown) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/mode_selector_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="-25dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/header_section">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODE DE NAVIGATION"
                android:textColor="#757575"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <Spinner
                android:id="@+id/spinnerMode"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_spinner_frame"
                android:paddingEnd="8dp"
                android:paddingStart="8dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Map View -->
    <com.example.geo_slam.ui.map.MapCanvasView
        android:id="@+id/mapCanvasView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        android:background="@drawable/bg_map_frame"
        app:layout_constraintTop_toBottomOf="@id/mode_selector_card"
        app:layout_constraintBottom_toTopOf="@id/legend_card" />

    <!-- Légende Compacte (Grille 2x2) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/legend_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toTopOf="@id/actions_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LÉGENDE"
                android:textColor="#757575"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <!-- Grille de légende -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins">

                <LinearLayout android:layout_width="0dp" android:layout_gravity="fill_horizontal" android:layout_columnWeight="1" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <View android:layout_width="12dp" android:layout_height="3dp" android:background="#673AB7"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/legend_foot" android:textSize="10sp" android:layout_marginStart="6dp" android:textColor="#424242"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_gravity="fill_horizontal" android:layout_columnWeight="1" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                    <View android:layout_width="12dp" android:layout_height="3dp" android:background="#26A69A"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/legend_vslam" android:textSize="10sp" android:layout_marginStart="6dp" android:textColor="#424242"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_gravity="fill_horizontal" android:layout_columnWeight="1" android:gravity="center_vertical">
                    <View android:layout_width="12dp" android:layout_height="3dp" android:background="#3F51B5"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/legend_fusion" android:textSize="10sp" android:layout_marginStart="6dp" android:textColor="#424242"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_gravity="fill_horizontal" android:layout_columnWeight="1" android:gravity="center_vertical">
                    <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/dot_red"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/legend_position" android:textSize="10sp" android:layout_marginStart="6dp" android:textColor="#424242"/>
                </LinearLayout>

            </GridLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Actions -->
    <LinearLayout
        android:id="@+id/actions_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Arrêter"
            android:textColor="#FF5252"
            app:icon="@drawable/ic_stop"
            app:iconTint="#FF5252"
            android:textSize="12sp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_save"
            app:iconPadding="0dp"
            app:iconGravity="textStart"
            android:backgroundTint="#B2EBF2"
            app:iconTint="#26A69A"
            app:cornerRadius="8dp"/>

    </LinearLayout>

    <!-- Calibration Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/calibrationOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:elevation="20dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/txtCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3"
            android:textColor="#FFFFFF"
            android:textSize="100sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
