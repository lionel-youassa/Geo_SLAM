<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".MainActivity">

    <!-- Panneau de bord Sonia -->
    <LinearLayout
        android:id="@+id/header_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#22FFFFFF"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/sample_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Geo-SLAM : Sonia 3D Engine"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_pos_x"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="X : 0.00 m"
            android:textColor="#00E676" />

        <TextView
            android:id="@+id/tv_pos_y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Y : 0.00 m"
            android:textColor="#00E676" />

        <TextView
            android:id="@+id/tv_pos_z"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Altitude : 0.00 m"
            android:textColor="#29B6F6" />
    </LinearLayout>

    <!-- INTERFACE DE SONIA : Le moteur de rendu MapRenderer -->
    <SurfaceView
        android:id="@+id/map_surface_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header_panel"
        app:layout_constraintBottom_toTopOf="@id/btn_reset"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- On garde la vue de test en overlay léger (optionnel) -->
    <com.example.geo_slam.ui.TrajectoryView
        android:id="@+id/trajectory_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.2"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/map_surface_view"
        app:layout_constraintBottom_toBottomOf="@id/map_surface_view"
        app:layout_constraintStart_toStartOf="@id/map_surface_view"
        app:layout_constraintEnd_toEndOf="@id/map_surface_view" />

    <Button
        android:id="@+id/btn_reset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RESET POSITION"
        android:backgroundTint="#FF5252"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/footer_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/footer_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sonia UI Engine - Connected to Lionel IA"
        android:textColor="#88FFFFFF"
        android:textAlignment="center"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>